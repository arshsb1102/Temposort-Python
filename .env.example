APP_NAME=TempoSort FastAPI
APP_ENV=development
DEBUG=false
JWT_SECRET=replace-with-your-dev-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/temposort
REDIS_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND_URL=redis://localhost:6379/1
REDIS_CACHE_TTL_SECONDS=300
REMINDER_DIGEST_ENABLED=true
REMINDER_DIGEST_HOUR=9
REMINDER_DIGEST_MINUTE=0
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
OTEL_SERVICE_NAME=temposort-api
METRICS_ENABLED=true
GRAFANA_ADMIN_PASSWORD=replace-with-local-dashboard-password
API_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
MAIL_PROVIDER=resend
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=onboarding@yourdomain.com
SMTP_FROM_NAME=TempoSort
SMTP_ENABLE_SSL=false
RESEND_API_KEY=replace-with-your-resend-api-key
